# Copy to .env (for `npm run dev`, Node >= 20.6) or export in your shell.
# Leave LLM_API_KEY empty to run in DEMO mode (canned answers, no LLM call).
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4
PORT=3000
# Max chat requests per IP per minute (protects your key on a public URL)
RATE_LIMIT_PER_MIN=20
